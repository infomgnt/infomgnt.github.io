@article{huvila_data_2025,
	title = {Data Makers and Users' Views on Useful Paradata: Priorities in Documenting Data Creation, Curation, Manipulation and Use in Archaeology},
	volume = {19},
	rights = {http://creativecommons.org/licenses/by/4.0},
	issn = {1746-8256},
	url = {https://ijdc.net/index.php/ijdc/article/view/892},
	doi = {10.2218/ijdc.v19i1.892},
	shorttitle = {Data Makers and Users' Views on Useful Paradata},
	abstract = {Understanding and making data (re)usable requires adequate documentation of the data but also information on how it has been created, curated, manipulated and used, termed in data documentation literature as paradata. This paper reports results of a survey study (N=91) of data creating and (re)using archaeologists' views of what data creation, curation, manipulation and use related information (termed here as paradata) they consider important when they are working with data. Data makers' and users' perceptions align to a considerable degree. It is important to have an explanation of the original general context of data creation and knowing the purpose, procedures and methods of data making, analysis and documentation. The findings underline that there is a need to continue developing and testing ideas how to capture and document paradata, and to find ways how to help data makers adopt proven practices to facilitate paradata making. Simultaneously, it is crucial that the paradata aimed at facilitating data use is relevant for data users rather than, for instance, technical or administrative details considered useful primarily by data makers.},
	pages = {24},
	number = {1},
	journaltitle = {International Journal of Digital Curation},
	shortjournal = {{IJDC}},
	author = {Huvila, Isto and Andersson, Lisa and Sköld, Olle and Liu, Ying-Hsang},
	urldate = {2026-04-10},
	date = {2025-02-11},
	keywords = {Read},
	file = {Full Text:C\:\\Users\\User\\Zotero\\storage\\JTHCFXEV\\Huvila et al. - 2025 - Data Makers and Users' Views on Useful Paradata Priorities in Documenting Data Creation, Curation,.pdf:application/pdf},
